# ─────────────────────────────────────────────────────────────────────────────
# Document Intelligence Agent — environment configuration
#
# Copy to `.env` (gitignored) and adjust:   cp .env.example .env
# One root .env drives Docker Compose AND the locally-run backend.
# Never commit real keys or passwords.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required for real extraction / agents (features 0002+). The app and /api/health
# start fine without it; tests never use it (they use FakeLLM).
OPENAI_API_KEY=

# Model used for text / structured-output / tool-calling requests.
OPENAI_MODEL=gpt-4.1-mini
# Model used for image (vision) OCR of JPG/PNG/scanned PDFs.
OPENAI_VISION_MODEL=gpt-4.1-mini
# Embedding model for invoice search (pgvector column size must match its output).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Per-attempt timeout (seconds) and how many times a rate-limited, timed-out or failed (5xx)
# OpenAI call is retried with backoff (0-10; done by app/core/llm.py, not the SDK).
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# ── PostgreSQL + pgvector ────────────────────────────────────────────────────
POSTGRES_USER=appfuxion
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=appfuxion
# `localhost` when the backend runs on your machine; Compose overrides it to `db`
# for the containerised backend.
POSTGRES_HOST=localhost
# Host port published for the database container (and used by a locally-run backend).
# Change it (e.g. 5433) if another Postgres already holds 5432. Inside Compose the
# backend always talks to the db container on 5432, regardless of this value.
DB_PORT=5432
# Optional: full SQLAlchemy URL. Leave blank to derive it from the POSTGRES_* values
# above (driver: postgresql+psycopg).
DATABASE_URL=

# ── Backend ──────────────────────────────────────────────────────────────────
# `single` = one Document Agent; `multi` = a Coordinator runs the Extraction ->
# Validation -> Reporting agents (feature 0011).
AGENT_MODE=multi
# Totals in another currency are converted to this ISO 4217 code (one of the 25
# currencies in the static rate table, e.g. MYR, SGD, USD).
BASE_CURRENCY=MYR
# Single mode only: most model turns one agent run may take (1-30); the happy path needs 9.
# Multi mode limits each agent in code (Extraction 6, Validation 6, Reporting 4).
AGENT_MAX_STEPS=14
# Most model turns the Query Agent (Ask AI chat) may take per question (1-20).
QUERY_MAX_STEPS=6
# Upload size limit in megabytes (larger files are rejected with 413).
MAX_UPLOAD_MB=10
# Where uploaded files are stored. Relative paths resolve against the backend/ folder;
# Compose overrides it to a volume-backed path inside the container.
STORAGE_DIR=./storage
# Most pages of a scanned PDF sent to the vision model (>= 1); later pages are skipped
# to bound cost. Text-layer PDFs are parsed locally and are not affected.
VISION_MAX_PAGES=5
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Frontend (Docker) ────────────────────────────────────────────────────────
# Host port where the nginx-served UI is published: http://localhost:8080
FRONTEND_PORT=8080
